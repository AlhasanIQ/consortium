    {
      "id": "aggregation-debate",
      "type": "aggregation",
      "position": {
        "x": 806,
        "y": 720
      },
      "data": {
        "type": "aggregation",
        "label": "Debate Aggregation",
        "config": {
          "name": "Debate Aggregation",
          "description": "The winning response selected by camp adjudication",
          "aggregationMethod": "debate_decide",
          "aggregationConfig": {
            "system_prompt": "You are an impartial judge adjudicating between camps of independent agents. Choose the camp with the strongest reasoning, not the largest camp by default.\n\nDecision process:\n1. Read each camp's answer and supporting arguments.\n2. Check for concrete factual errors, invalid assumptions, logical contradictions, unsupported leaps, or missing constraints.\n3. Prefer the camp whose reasoning is most correct, complete, and well supported.\n4. Use camp size only as weak tie-breaking evidence when reasoning quality is otherwise comparable.\n\nAfter your analysis, end with exactly one line:\nWINNER: [answer]\n\nWhere [answer] is the final answer represented by the camp with the strongest arguments.",
            "temperature": 0,
            "openRouterReasoning": {
              "effort": "low"
            },
            "extraction_strategy": "regex",
            "judge_model": "deepseek/deepseek-v4-pro",
            "max_tokens": -1,
            "repair_max_tokens": 256,
            "prompt": "Original Question: {{prompt}}\\n\\nCamp summaries:\\n{{camps}}\\n\\nReturn WINNER: [answer].",
            "extraction_pattern": "(?im)(?:^|\\n|[^\\n]{0,60}\\b)(?:final answer|answer)\\s*(?:(?:is)?\\s*[:\\-]\\s*(?:\\(?([A-Z])\\)?\\s*(?:[.)]?\\s*$|\\s+(?:is|was|are|because|since|as|therefore|so)\\b)|\\(?([^\\n)]{1,80}?)\\)?\\s*(?:[.;]\\s*$|$|\\n|[.;]\\s+(?:because|since|as|this|the|it)\\b|,?\\s+(?:because|since|as|therefore|so)\\b))|is\\s*:?\\s*(?:\\(?([A-Z])\\)?\\s*(?:[.)]?\\s*$|\\s+(?:is|was|are|because|since|as|therefore|so)\\b)|([-+]?(?:\\d+(?:\\.\\d+)?|[A-Z]\\s*=\\s*[-+]?\\d+(?:\\.\\d+)?))\\s*(?:[.;]?\\s*$|,?\\s+(?:because|since|as|therefore|so)\\b)))"
          },
          "timeoutSeconds": 180,
          "retryPolicy": {
            "max_attempts": 1
          },
          "aggregationWorkflowId": "aggregation-debate-decide"
        }
      }
    },
