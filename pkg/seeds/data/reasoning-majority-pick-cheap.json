      },
      "data": {
        "type": "input",
        "label": "User Prompt",
        "config": {
          "name": "user_prompt",
          "description": "The question or prompt to send to all council members",
          "schema": {
            "user_prompt": {
              "type": "string",
              "required": true
            }
          },
          "maxTokens": -1
        }
      }
    },
    {
      "id": "agent-deepseek-flash",
      "type": "agent",
      "position": {
        "x": 1312,
        "y": 370
      },
      "data": {
        "type": "agent",
        "label": "DeepSeek V4 Flash",
        "config": {
          "name": "DeepSeek V4 Flash",
          "provider": "openrouter",
          "model": "deepseek/deepseek-v4-flash",
          "openRouterReasoning": {
            "effort": "high"
          },
          "systemPrompt": "You are an expert problem solver. Think through problems carefully:\n1. Identify what is being asked\n2. Consider the key facts and evidence\n3. Reason step by step through the problem\n4. Check your reasoning for errors or gaps\n5. State your final answer clearly\n\nBe precise and thorough. If you are uncertain, explain why.",
          "userPrompt": "{{user_prompt}}",
          "temperature": 0,
          "timeoutSeconds": 180,
          "maxTokens": -1,
          "retryPolicy": {
            "max_attempts": 5,
            "backoff_ms": 1000,
            "backoff_multiply": 2,
            "max_backoff_ms": 30000
          }
        }
      }
    },
    {
      "id": "agent-minimax",
      "type": "agent",
      "position": {
        "x": 120,
        "y": 370
      },
      "data": {
        "type": "agent",
        "label": "MiniMax M3",
        "config": {
          "name": "MiniMax M3",
          "provider": "openrouter",
          "model": "minimax/minimax-m3",
          "openRouterReasoning": {
            "effort": "high"
          },
          "systemPrompt": "You are an expert problem solver. Think through problems carefully:\n1. Identify what is being asked\n2. Consider the key facts and evidence\n3. Reason step by step through the problem\n4. Check your reasoning for errors or gaps\n5. State your final answer clearly\n\nBe precise and thorough. If you are uncertain, explain why.",
          "userPrompt": "{{user_prompt}}",
          "temperature": 0,
          "timeoutSeconds": 180,
          "maxTokens": -1,
          "retryPolicy": {
            "max_attempts": 5,
            "backoff_ms": 1000,
            "backoff_multiply": 2,
            "max_backoff_ms": 30000,
            "adaptive_reasoning": {
              "trigger_error_codes": [
                "OUTPUT_TRUNCATED_EMPTY",
                "TIMEOUT"
              ],
              "activate_after_consecutive": 2,
              "ladder": [
                "high",
                "medium",
                "low"
              ]
            }
          }
        }
      }
    },
    {
      "id": "agent-mimo",
      "type": "agent",
      "position": {
        "x": 716,
        "y": 370
      },
      "data": {
        "type": "agent",
        "label": "MiMo V2.5",
        "config": {
          "name": "MiMo V2.5",
          "provider": "openrouter",
          "model": "xiaomi/mimo-v2.5",
          "openRouterReasoning": {
            "effort": "high"
          },
          "systemPrompt": "You are an expert problem solver. Think through problems carefully:\n1. Identify what is being asked\n2. Consider the key facts and evidence\n3. Reason step by step through the problem\n4. Check your reasoning for errors or gaps\n5. State your final answer clearly\n\nBe precise and thorough. If you are uncertain, explain why.",
          "userPrompt": "{{user_prompt}}",
          "temperature": 0,
          "timeoutSeconds": 180,
          "maxTokens": -1,
          "retryPolicy": {
            "max_attempts": 5,
            "backoff_ms": 1000,
            "backoff_multiply": 2,
            "max_backoff_ms": 30000
