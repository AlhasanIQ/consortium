{
  "created_at": "2026-06-23T00:00:00Z",
  "description": "Reusable L0 aggregation workflow that asks a blind judge to select the best candidate",
  "edges": [
    {
      "id": "edge-input-format",
      "source": "input-contract",
      "target": "op-format-candidates"
    },
    {
      "id": "edge-format-judge",
      "source": "op-format-candidates",
      "target": "agent-judge"
    },
    {
      "id": "edge-judge-parse",
      "source": "agent-judge",
      "target": "op-parse-selection"
    },
    {
      "id": "edge-parse-select",
      "source": "op-parse-selection",
      "target": "op-select-winner"
    },
    {
      "id": "edge-select-result",
      "source": "op-select-winner",
      "target": "result-aggregation"
    }
  ],
  "id": "aggregation-judge",
  "metadata": {
    "tags": [
      "aggregation",
      "judge"
    ],
    "input_contract": {
      "aggregation_config": "judge model, prompt, and extraction settings",
      "candidate_ids": "ordered IDs for upstream candidate nodes",
      "candidate_models": "model IDs keyed by candidate ID",
      "candidates": "ordered candidate outputs",
      "user_prompt": "original user prompt"
    }
  },
  "name": "Aggregation Judge",
  "nodes": [
    {
      "data": {
        "config": {
          "description": "Parent-supplied aggregation inputs",
          "name": "aggregation_inputs",
          "schema": {
            "aggregation_config": {
              "required": false,
              "type": "object"
            },
            "candidate_ids": {
              "required": false,
              "type": "array"
            },
            "candidate_models": {
              "required": false,
              "type": "object"
            },
            "candidates": {
              "required": true,
              "type": "array"
            },
            "user_prompt": {
              "required": true,
              "type": "string"
            }
          }
        },
        "label": "Aggregation Inputs",
        "type": "input"
      },
      "id": "input-contract",
      "position": {
        "x": 260,
        "y": 80
      },
      "type": "input"
    },
    {
      "data": {
        "config": {
          "description": "Format candidates for blind judging",
          "name": "Format Candidates",
          "operationConfig": {
            "candidates": "{{candidates}}"
          },
          "operationType": "format_candidates"
        },
        "label": "Format Candidates",
        "type": "operation"
      },
      "id": "op-format-candidates",
      "position": {
        "x": 120,
        "y": 370
      },
      "type": "operation"
    },
    {
      "data": {
        "config": {
          "maxTokens": -1,
          "model": "deepseek/deepseek-v4-pro",
          "name": "Judge",
          "systemPrompt": "You are an impartial judge. Select the strongest candidate by reasoning quality and correctness. Return JSON with a winner field containing the chosen candidate label.",
          "temperature": 0.2,
          "timeoutSeconds": 180,
          "userPrompt": "Original prompt:\n{{user_prompt}}\n\nCandidates:\n{{op-format-candidates}}\n\nReturn JSON: {\"winner\":\"A\",\"reason\":\"...\"}",
          "retryPolicy": {
            "max_attempts": 1
          }
        },
        "label": "Judge",
        "type": "agent"
      },
      "id": "agent-judge",
      "position": {
        "x": 120,
        "y": 720
      },
      "type": "agent"
    },
    {
      "data": {
        "config": {
          "description": "Parse judge selection",
          "name": "Parse Selection",
          "operationConfig": {
            "field": "winner",
            "text": "{{agent-judge}}"
          },
          "operationType": "parse_json_field"
        },
        "label": "Parse Selection",
        "type": "operation"
      },
      "id": "op-parse-selection",
      "position": {
        "x": 120,
        "y": 1070
      },
      "type": "operation"
    },
    {
      "data": {
        "config": {
          "description": "Map selected label back to candidate output",
          "name": "Select Winner",
          "operationConfig": {
            "outputs": "{{candidate_outputs}}",
            "scores": "{{selection_scores}}"
          },
          "operationType": "select_winner"
        },
        "label": "Select Winner",
        "type": "operation"
      },
      "id": "op-select-winner",
      "position": {
        "x": 120,
        "y": 1420
      },
      "type": "operation"
    },
    {
      "data": {
        "config": {
          "aggregationMethod": "collect",
          "name": "aggregation_result",
          "outputFormat": "text",
          "retryPolicy": {
            "max_attempts": 1
          }
        },
        "label": "Aggregation Result",
        "type": "result"
      },
      "id": "result-aggregation",
      "position": {
        "x": 240,
        "y": 1770
      },
      "type": "result"
    }
  ],
  "updated_at": "2026-06-23T00:00:00Z"
}
