{
  "created_at": "2026-06-23T00:00:00Z",
  "description": "Reusable L0 aggregation workflow that extracts answers and counts votes mechanically",
  "edges": [
    {
      "id": "edge-input-extract",
      "source": "input-contract",
      "target": "op-extract-answer"
    },
    {
      "id": "edge-extract-count",
      "source": "op-extract-answer",
      "target": "op-count-votes"
    },
    {
      "id": "edge-count-result",
      "source": "op-count-votes",
      "target": "result-aggregation"
    }
  ],
  "id": "aggregation-majority-vote",
  "metadata": {
    "tags": [
      "aggregation",
      "majority-vote"
    ],
    "input_contract": {
      "aggregation_config": "extraction strategy and tie policy",
      "candidate_ids": "ordered IDs for upstream candidate nodes",
      "candidate_models": "model IDs keyed by candidate ID",
      "candidates": "ordered candidate outputs",
      "user_prompt": "original user prompt"
    }
  },
  "name": "Aggregation Majority Vote",
  "nodes": [
    {
      "data": {
        "config": {
          "description": "Parent-supplied aggregation inputs",
          "name": "aggregation_inputs",
          "schema": {
            "aggregation_config": {
              "required": false,
              "type": "object"
            },
            "candidate_ids": {
              "required": false,
              "type": "array"
            },
            "candidate_models": {
              "required": false,
              "type": "object"
            },
            "candidates": {
              "required": true,
              "type": "array"
            },
            "user_prompt": {
              "required": true,
              "type": "string"
            }
          }
        },
        "label": "Aggregation Inputs",
        "type": "input"
      },
      "id": "input-contract",
      "position": {
        "x": 260,
        "y": 80
      },
      "type": "input"
    },
    {
      "data": {
        "config": {
          "description": "Extract answer labels from candidate outputs",
          "name": "Extract Answers",
          "operationConfig": {
            "extraction_pattern": "{{aggregation_config.extraction_pattern}}",
            "extraction_strategy": "{{aggregation_config.extraction_strategy}}",
            "text": "{{candidates}}"
          },
          "operationType": "extract_answer"
        },
        "label": "Extract Answers",
        "type": "operation"
      },
      "id": "op-extract-answer",
      "position": {
        "x": 120,
        "y": 370
      },
      "type": "operation"
    },
    {
      "data": {
        "config": {
          "description": "Count extracted answer votes",
          "name": "Count Votes",
          "operationConfig": {
            "answers": "{{answers}}"
          },
          "operationType": "count_votes"
        },
        "label": "Count Votes",
        "type": "operation"
      },
      "id": "op-count-votes",
      "position": {
        "x": 120,
        "y": 720
      },
      "type": "operation"
    },
    {
      "data": {
        "config": {
          "aggregationMethod": "collect",
          "name": "aggregation_result",
          "outputFormat": "text",
          "retryPolicy": {
            "max_attempts": 1
          }
        },
        "label": "Aggregation Result",
        "type": "result"
      },
      "id": "result-aggregation",
      "position": {
        "x": 240,
        "y": 1070
      },
      "type": "result"
    }
  ],
  "updated_at": "2026-06-23T00:00:00Z"
}
