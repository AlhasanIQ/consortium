        "config": {
          "maxTokens": -1,
          "model": "deepseek/deepseek-v4-pro",
          "name": "Camp Judge",
          "systemPrompt": "You are an impartial judge comparing answer camps. Select the camp with the strongest reasoning, not the largest camp by default.",
