# API keys
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
ARTIFICIAL_ANALYSIS_API_KEY=  # Optional: used by benchmark model sync tooling

# Server Configuration
PORT=8080
BIND_ADDR=127.0.0.1:8080           # Bind address (default: 127.0.0.1:$PORT; use 0.0.0.0 only behind trusted auth/proxy)
ADMIN_API_TOKEN=                   # Optional bearer token for /api/admin/*; required for non-loopback binds unless ALLOW_UNAUTH_ADMIN=true
ALLOW_UNAUTH_ADMIN=false           # Unsafe override for non-loopback binds without ADMIN_API_TOKEN
CONCTL_ADMIN_API_TOKEN=            # Set to ADMIN_API_TOKEN when using conctl against protected admin APIs
BACKEND_URL=http://localhost:8080
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
CONCTL_URL=http://localhost:8080

# Optional Novomo agent runtime.
# See https://github.com/alhasaniq/novomo and https://novomo.alhasaniq.com.
# NOVOMO_URL defaults to http://localhost:8090 when unset.
# NOVOMO_URL=http://localhost:8090
# NOVOMO_API_KEY=<NOVOMO_API_KEY>
# NOVOMO_FRONTEND_V2_URL defaults to http://127.0.0.1:5174 for admin deep links.
# NOVOMO_FRONTEND_V2_URL=http://127.0.0.1:5174

# Database
DB_PATH=./consortium.db

# Worktree-local overrides
# Put per-worktree ports and DB settings in .env.local. Example:
# PORT=8182
# FRONTEND_PORT=3102
# BACKEND_URL=http://localhost:8182
# FRONTEND_URL=http://localhost:3102
# CONCTL_URL=http://localhost:8182
# DB_PATH=./.local/agent-a/consortium.db

# Production Deployment
EMBED_FRONTEND=false               # Set to 'true' to serve embedded frontend assets
DEV_STATIC_PATH=./frontend/dist    # Path to frontend assets in dev mode
