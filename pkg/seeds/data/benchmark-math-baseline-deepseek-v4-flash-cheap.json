{
  "version": "1.0.0",
  "id": "benchmark-math-baseline-deepseek-v4-flash-cheap",
  "name": "Benchmark Math-500 Baseline DeepSeek V4 Flash (Cheap)",
  "description": "Single-model math benchmark wrapper with expression output",
  "created_at": "2026-02-26T00:00:00Z",
  "updated_at": "2026-02-28T00:00:00Z",
  "nodes": [
    {
      "id": "input-prompt",
      "type": "input",
      "position": {
        "x": 260,
        "y": 80
      },
      "data": {
        "type": "input",
        "label": "Benchmark Question",
        "config": {
          "description": "A math benchmark question",
          "maxTokens": -1,
          "name": "user_prompt",
          "schema": {
            "user_prompt": {
              "required": true,
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "agent-solver",
      "type": "agent",
      "position": {
        "x": 120,
        "y": 370
      },
      "data": {
        "type": "agent",
        "label": "DeepSeek V4 Flash",
        "config": {
          "maxTokens": -1,
          "model": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "openRouterReasoning": {
            "effort": "high"
          },
          "provider": "openrouter",
          "systemPrompt": "You are an expert problem solver. Think through problems carefully:\n1. Identify what is being asked\n2. Consider the key facts and evidence\n3. Reason step by step through the problem\n4. Check your reasoning for errors or gaps\n5. State your final answer clearly\n\nBe precise and thorough. If you are uncertain, explain why.",
          "temperature": 0,
          "timeoutSeconds": 180,
          "userPrompt": "You are solving a math reasoning problem.\nProvide concise, correct derivation steps.\nEnd with exactly one line in this format:\nFinal answer: <your final expression>\n\n{{user_prompt}}",
          "retryPolicy": {
            "max_attempts": 5,
            "backoff_ms": 1000,
            "backoff_multiply": 2,
            "max_backoff_ms": 30000
          }
        }
      }
    },
    {
      "id": "aggregation-benchmark-answer",
      "type": "aggregation",
      "position": {
        "x": 210,
        "y": 720
      },
      "data": {
        "type": "aggregation",
        "label": "Benchmark Answer Aggregation",
        "config": {
          "name": "Benchmark Answer Aggregation",
          "description": "Canonical math benchmark answer output",
          "aggregationMethod": "collect",
          "aggregationConfig": {},
          "timeoutSeconds": 120,
          "retryPolicy": {
            "max_attempts": 1
          },
          "benchmarkOutputPackaging": true
        }
      }
    },
    {
      "id": "result-benchmark-answer",
      "type": "result",
      "position": {
        "x": 240,
        "y": 1090
      },
      "data": {
        "type": "result",
        "label": "Benchmark Answer",
        "config": {
          "name": "benchmark_answer",
          "description": "Canonical math benchmark answer output",
          "outputFormat": "text"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-agent-solver-aggregation-benchmark-answer",
      "source": "agent-solver",
      "target": "aggregation-benchmark-answer"
    },
    {
      "id": "edge-input-solver",
      "source": "input-prompt",
      "target": "agent-solver"
    },
    {
      "id": "edge-aggregation-benchmark-answer-result-benchmark-answer",
      "source": "aggregation-benchmark-answer",
      "target": "result-benchmark-answer"
    }
  ],
  "metadata": {
    "tags": [
      "baseline",
      "benchmark",
      "deepseek-flash",
      "math-500",
      "non-mcqa",
      "single-model"
    ]
  },
  "optimize": {
    "params": [
      {
        "path": "nodes[agent-solver].data.config.model",
        "type": "model",
        "candidates": [
          "xiaomi/mimo-v2.5",
          "deepseek/deepseek-v4-flash",
          "minimax/minimax-m3"
        ],
        "group": "agent_models"
      },
      {
        "path": "nodes[agent-solver].data.config.systemPrompt",
        "type": "prompt",
        "group": "agent_prompts"
      },
      {
        "path": "nodes[agent-solver].data.config.temperature",
        "type": "float",
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.1
        },
        "group": "agent_temperatures"
      }
    ],
    "locked": [
      "nodes[aggregation-benchmark-answer].data.config.aggregationMethod"
    ],
    "objectives": [
      {
        "metric": "accuracy",
        "direction": "maximize",
        "weight": 3
      },
      {
        "metric": "cost_per_item",
        "direction": "minimize",
        "weight": 1
      }
    ],
    "constraints": [
      {
        "metric": "cost_per_item",
        "op": "<=",
        "value": 0.05
      },
      {
        "metric": "parse_rate",
        "op": ">=",
        "value": 0.95
      }
    ],
    "stop_policy": {
      "max_generations": 20,
      "budget_usd": 10,
      "plateau_generations": 5,
      "stability_top_k": 3
    },
    "promotion_policy": {
      "min_accuracy_gain": 0.02,
      "require_generalization_check": true,
      "no_regression_on": [
        "parse_rate",
        "cost_per_item"
      ]
    }
  }
}
