# LLM providers
# Configure at least one provider. OpenRouter remains the default hosted path.
OPENROUTER_API_KEY=

# Optional OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, etc.).
# Base URL must contain /models and /chat/completions, usually ending in /v1.
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# API key is optional for local endpoints.
OPENAI_COMPATIBLE_API_KEY=
# Optional comma-separated fallback when the endpoint does not expose /models.
# Models are exposed inside Consortium as compatible/<model-id>.
OPENAI_COMPATIBLE_MODELS=

# Required by benchmark model sync tooling (Artificial Analysis V2 Free API).
ARTIFICIAL_ANALYSIS_API_KEY=

# Server Configuration
PORT=8080
# Bind address (default: 127.0.0.1:$PORT; use 0.0.0.0 only behind trusted auth/proxy).
BIND_ADDR=127.0.0.1:8080
# Optional bearer token for /api/admin/*; required for non-loopback binds unless ALLOW_UNAUTH_ADMIN=true.
ADMIN_API_TOKEN=
# Unsafe override for non-loopback binds without ADMIN_API_TOKEN.
ALLOW_UNAUTH_ADMIN=false
# Set to ADMIN_API_TOKEN when using conctl against protected admin APIs.
CONCTL_ADMIN_API_TOKEN=
BACKEND_URL=http://localhost:8080
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
CONCTL_URL=http://localhost:8080

# Optional Novomo agent runtime.
# See https://github.com/alhasaniq/novomo and https://novomo.alhasaniq.com.
# NOVOMO_URL defaults to http://localhost:8090 when unset.
# NOVOMO_URL=http://localhost:8090
# NOVOMO_API_KEY=<NOVOMO_API_KEY>
# NOVOMO_FRONTEND_V2_URL defaults to http://127.0.0.1:5174 for admin deep links.
# NOVOMO_FRONTEND_V2_URL=http://127.0.0.1:5174

# Database
DB_PATH=./consortium.db

# Worktree-local overrides
# Put per-worktree ports and DB settings in .env.local. Example:
# PORT=8182
# FRONTEND_PORT=3102
# BACKEND_URL=http://localhost:8182
# FRONTEND_URL=http://localhost:3102
# CONCTL_URL=http://localhost:8182
# DB_PATH=./.local/agent-a/consortium.db

# Production Deployment
# Set to 'true' to serve embedded frontend assets.
EMBED_FRONTEND=false
# Path to frontend assets in dev mode.
DEV_STATIC_PATH=./frontend/dist
