            "aggregation_config": {
              "required": false,
              "type": "object"
            },
            "candidate_ids": {
              "required": false,
              "type": "array"
            },
            "candidate_models": {
              "required": false,
              "type": "object"
            },
            "candidates": {
              "required": true,
              "type": "array"
            },
            "user_prompt": {
              "required": true,
              "type": "string"
            }
          }
        },
        "label": "Aggregation Inputs",
        "type": "input"
