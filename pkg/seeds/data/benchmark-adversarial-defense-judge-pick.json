{
  "version": "1.0.0",
  "id": "benchmark-adversarial-defense-judge-pick",
  "name": "Benchmark Adversarial Defense Judge Pick",
  "description": "Parent benchmark wrapper for reasoning-adversarial-defense-judge-pick with strict benchmark_answer output",
  "created_at": "2026-02-09T00:00:00Z",
  "updated_at": "2026-02-09T00:00:00Z",
  "nodes": [
    {
      "id": "input-prompt",
      "type": "input",
      "position": {
        "x": 260,
        "y": 80
      },
      "data": {
        "type": "input",
        "label": "Benchmark Question",
        "config": {
          "description": "A multiple-choice benchmark question with labeled options",
          "maxTokens": -1,
          "name": "user_prompt",
          "schema": {
            "user_prompt": {
              "required": true,
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "child-reasoning-adversarial-defense-judge-pick",
      "type": "child_workflow",
      "position": {
        "x": 210,
        "y": 370
      },
      "data": {
        "type": "child_workflow",
        "label": "Run Adversarial Defense Judge Pick Child",
        "config": {
          "await": true,
          "childWorkflowId": "reasoning-adversarial-defense-judge-pick",
          "description": "Executes reasoning-adversarial-defense-judge-pick as a child workflow",
          "inputTemplate": {
            "user_prompt": "You are solving a multiple-choice question.\nChoose exactly one option and explain briefly why it is correct and not other options.\nRespond in this format:\nFinal answer: <ONE UPPERCASE LETTER>\nReasoning: <concise reasoning>\n\n{{user_prompt}}\n\nRemember: include both the final answer line and a brief reasoning line."
          },
          "maxTokens": -1,
          "name": "Run Adversarial Defense Judge Pick Child",
          "outputKey": "debate_judgment",
          "timeoutSeconds": 900,
          "retryPolicy": {
            "max_attempts": 5,
            "backoff_ms": 1000,
            "backoff_multiply": 2,
            "max_backoff_ms": 30000
          }
        }
      }
    },
    {
      "id": "agent-contract",
      "type": "contract_extract",
      "position": {
        "x": 120,
        "y": 700
      },
      "data": {
        "type": "contract_extract",
        "label": "Benchmark Contract",
        "config": {
          "sourceVariable": "child-reasoning-adversarial-defense-judge-pick",
          "extractionPatterns": [
            "^\\s*([A-Za-z])\\s*$",
            "(?i)\\b(?:final\\s+answer|answer)\\b(?:\\s+is)?\\s*[:\\-]?\\s*\\(?\\s*([A-Za-z])\\s*\\)?\\s*(?:$|\\n|[^A-Za-z])",
            "^\\s*\\(?\\s*([A-Za-z])\\s*\\)?[\\.\\):\\-]"
          ],
          "maxTokens": 1024,
          "model": "deepseek/deepseek-v4-pro",
          "name": "Benchmark Contract",
          "openRouterReasoning": {
            "effort": "none"
          },
          "provider": "openrouter",
          "systemPrompt": "You are a benchmark answer extractor, not a solver. Use ONLY the text in the section titled \"Reasoning workflow answer\" as the source of truth. Do NOT use external knowledge or re-evaluate the question. Extract the final selected option from that section and return exactly one uppercase letter (A-Z), with no punctuation or explanation.",
          "temperature": 0,
          "timeoutSeconds": 20,
          "userPrompt": "Question and options:\n{{user_prompt}}\n\nReasoning workflow answer:\n{{child-reasoning-adversarial-defense-judge-pick}}\n\nReturn only the final single-letter answer:",
          "retryPolicy": {
            "max_attempts": 5,
            "backoff_ms": 1000,
            "backoff_multiply": 2,
            "max_backoff_ms": 30000
          }
        }
      }
    },
    {
      "id": "aggregation-benchmark-answer",
      "type": "aggregation",
      "position": {
        "x": 210,
        "y": 1050
      },
      "data": {
        "type": "aggregation",
        "label": "Benchmark Answer Aggregation",
        "config": {
          "name": "Benchmark Answer Aggregation",
          "description": "Canonical benchmark answer output",
          "aggregationMethod": "collect",
          "aggregationConfig": {},
          "timeoutSeconds": 120,
          "retryPolicy": {
            "max_attempts": 1
          },
          "benchmarkOutputPackaging": true
        }
      }
    },
    {
      "id": "result-benchmark-answer",
      "type": "result",
      "position": {
        "x": 240,
        "y": 1420
      },
      "data": {
        "type": "result",
        "label": "Benchmark Answer",
        "config": {
          "name": "benchmark_answer",
          "description": "Canonical benchmark answer output",
          "outputFormat": "text"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-input-child",
      "source": "input-prompt",
      "target": "child-reasoning-adversarial-defense-judge-pick"
    },
    {
      "id": "edge-child-contract",
      "source": "child-reasoning-adversarial-defense-judge-pick",
      "target": "agent-contract"
    },
    {
      "id": "edge-agent-contract-aggregation-benchmark-answer",
      "source": "agent-contract",
      "target": "aggregation-benchmark-answer"
    },
    {
      "id": "edge-aggregation-benchmark-answer-result-benchmark-answer",
      "source": "aggregation-benchmark-answer",
      "target": "result-benchmark-answer"
    }
  ],
  "metadata": {
    "tags": [
