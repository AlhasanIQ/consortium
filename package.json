{
  "name": "consortium",
  "version": "0.1.0",
  "description": "Self-hosted LLM workflow orchestration with a visual builder, durable runtime, and OpenAI-compatible API.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --config frontend/vite.config.ts",
    "build": "cd frontend && node ../node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --config frontend/vite.config.ts",
    "test": "bun test",
    "test:run": "bun test",
    "test:e2e:builder": "bun scripts/e2e-builder-aggregation.mjs",
    "test:e2e:builder:seeds": "bun scripts/e2e-builder-seed-render-sweep.mjs",
    "test:coverage": "bun test --coverage --coverage-reporter text --coverage-reporter lcov",
    "lint": "node node_modules/@biomejs/biome/bin/biome check frontend/src",
    "fix": "node node_modules/@biomejs/biome/bin/biome check --write frontend/src",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p frontend/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alhasaniq/consortium.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/alhasaniq/consortium/issues"
  },
  "homepage": "https://consortium.alhasaniq.com",
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.0",
    "bun-types": "^1.3.8",
    "tailwindcss": "^4.1.18",
    "typescript": "7.0.2",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@xyflow/react": "^12.8.6",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "lucide-react": "^0.563.0",
    "marked": "^16.4.0",
    "puppeteer": "^24.36.1",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.8"
  }
}
